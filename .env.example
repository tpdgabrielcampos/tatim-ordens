# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave secreta (NUNCA exponha no frontend) usada só pelo dashboard/servidor
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Senha de acesso ao painel /dashboard (escolha algo só seu)
ADMIN_PASSWORD=troque-esta-senha

# Endereço público do site (usado só pra montar o link "Ver no painel"
# dentro da descrição do cartão do Trello). Ex: https://labgabrielcampos.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Integração com o Trello (opcional — sem isso o sistema funciona igual,
# só não cria/move cartões automaticamente) ---
# Key, Token e Secret: gerados em https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_API_SECRET=

# URL completa desta rota, exatamente como cadastrada no webhook do Trello
# (usada só para conferir a assinatura das notificações que o Trello envia)
TRELLO_WEBHOOK_URL=https://SEU-SITE.vercel.app/api/trello/webhook

# Ids das listas do board do Trello — um pra cada status. Pegue esses ids
# abrindo, com a Key e o Token acima:
# https://api.trello.com/1/boards/SEU_BOARD/lists?key=SUA_KEY&token=SEU_TOKEN&fields=name,id
TRELLO_LIST_RECEBIDO=
TRELLO_LIST_STANDBY=
TRELLO_LIST_CAD=
TRELLO_LIST_CAM=
TRELLO_LIST_FINALIZACAO=
TRELLO_LIST_ENTREGUE=
TRELLO_LIST_CANCELADO=
